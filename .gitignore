# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment variables
# Ignore every .env variant anywhere in the tree; only *.example / *.sample
# templates are committed. A file is allowed back in solely because every
# value in it is a placeholder.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.sample
!**/.env.example
!**/.env.sample

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Project specific
uploads/
outputs/
*.log
*.db
saved_stories/
generated_stories/
db_data/
backend/backend/hash_cache.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
dist/
build/

# Testing
.coverage
htmlcov/
.pytest_cache/

# Docker
.dockerignore
backend/check_models.py
admin_token.txt

# Local edit backups
*.bak
*.bak.*
*.bak_*
# Pre-change snapshots taken before an audit/deploy edit - working copies of
# tracked files, kept only so a bad edit can be reverted locally.
.audit_backups/

# Ad-hoc DB dumps / removed-env snapshots taken before migrations - these can
# contain password hashes and other user data, never belong in git history.
backups/
frontend/.palette-backup-*/
frontend/.visual-backup-*/
frontend/public/.icons-backup-*/

# Runtime state written by deploy.sh / scripts/backup.sh and read back by
# routers/system.py - per-machine, never the same in two checkouts.
status/

# Scratch audio the admin TTS test tool used to leave behind.
backend/temp_audio_*.mp3
